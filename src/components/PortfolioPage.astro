---
import Footer from './Footer.astro';
import SourceLinks from './SourceLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, portfolio } from '../data/portfolio';
import { translations } from '../data/translations';
import type { Locale } from '../lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = translations[lang];
const content = portfolio[lang];
const { projects } = content;
const navigation = [
  ['about', 'About'], ['projects', 'Projects'], ['writing', 'Writing'], ['links', 'Links'],
];
---
<BaseLayout title={`${profile.name} — Portfolio`} description={t.description} lang={lang} page="portfolio">
  <div class="page-shell">
    <header class="site-header">
      <a class="wordmark" href="#top">{profile.name}<span aria-hidden="true">.</span></a>
      <div class="header-actions"><nav aria-label={t.navigation}>
        {navigation.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav><LanguageSwitcher lang={lang} page="portfolio" /></div>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero" id="top" aria-labelledby="hero-heading">
        <p class="eyebrow">PERSONAL PORTFOLIO <span aria-hidden="true">/</span> ta-dadadada</p>
        <h1 id="hero-heading">{t.heroFirst}<br />{t.heroPrefix}<span class="serif">{t.heroEmphasis}</span>{t.heroSuffix}</h1>
        <p class="hero-description">{t.heroDescription[0]}<br />{t.heroDescription[1]}</p>
        <a class="text-link" href="#projects">{t.viewProjects} <span aria-hidden="true">↘</span></a>
        <div class="hero-note"><span class="small-dot" aria-hidden="true"></span>{t.draft}</div>
        <SourceLinks section="hero" />
        <p class="hero-side" aria-hidden="true">BUILD. REFLECT. REFINE.</p>
      </section>
      <section class="content-section" id="about" aria-labelledby="about-heading">
        <div class="section-label"><span>01 / ABOUT</span><h2 id="about-heading">{t.about}</h2></div>
        <div class="section-body about-body"><p class="lead">{content.introduction}</p><p>{content.about}</p><p class="muted">{t.profilePending}</p><SourceLinks section="about" /></div>
      </section>
      <section class="content-section" id="projects" aria-labelledby="projects-heading">
        <div class="section-label"><span>02 / PROJECTS</span><h2 id="projects-heading">{t.projects}</h2></div>
        <div class="section-body project-list">
          {projects.map((project, index) => <article class="project">
            <div class="project-meta"><span>{project.category}</span><span>0{index + 1}</span></div>
            <h3>{project.name}</h3><p class="project-problem">{project.problem}</p><p>{project.approach}</p>
            <p class="muted project-status">{project.status}</p>
            {project.url && <a class="text-link" href={project.url}>{t.viewGitHub} <span aria-hidden="true">↗</span><span class="sr-only">：{project.name}</span></a>}
          </article>)}
          <SourceLinks section="projects" />
        </div>
      </section>
      <section class="content-section" id="writing" aria-labelledby="writing-heading">
        <div class="section-label"><span>03 / WRITING</span><h2 id="writing-heading">{t.writing}</h2></div>
        <div class="section-body"><p class="lead">{t.writingLead}</p><p>{t.writingDescription}</p><p class="muted">{t.writingEmpty}</p><SourceLinks section="writing" /></div>
      </section>
      <section class="content-section" id="links" aria-labelledby="links-heading">
        <div class="section-label"><span>04 / LINKS</span><h2 id="links-heading">{t.links}</h2></div>
        <div class="section-body"><a class="profile-link" href={profile.github}><span>GitHub<small>@{profile.name}</small></span><span aria-hidden="true">↗</span></a><SourceLinks section="links" /></div>
      </section>
    </main>
    <Footer lang={lang} />
  </div>
</BaseLayout>
