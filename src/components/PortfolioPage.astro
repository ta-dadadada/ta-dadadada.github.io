---
import Footer from './Footer.astro';
import SourceLinks from './SourceLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, portfolio, talks } from '../data/portfolio';
import { translations } from '../data/translations';
import { pagePath, type Locale } from '../lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = translations[lang];
const content = portfolio[lang];
const navigation = [
  ['projects', t.projects], ['talks', t.talks], ['writing', t.writing],
];
---
<BaseLayout title={`${profile.name} — Portfolio`} description={t.description} lang={lang} page="portfolio">
  <div class="portfolio-shell">
    <header class="profile-sidebar">
      <section id="top" aria-labelledby="profile-heading">
        <h1 id="profile-heading"><a class="wordmark" href="#top">{profile.name}</a></h1>
        <SourceLinks section="profile" />
      </section>
      <section id="about" class="profile-about" aria-labelledby="about-heading">
        <h2 id="about-heading" class="sr-only">{t.about}</h2>
        <p>{content.about}</p>
        <p class="muted">{t.draft}</p>
        <SourceLinks section="about" />
      </section>
      <nav class="profile-nav" aria-label={t.navigation}>
        {navigation.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
      <section id="links" aria-labelledby="links-heading">
        <h2 id="links-heading" class="sr-only">{t.links}</h2>
        <div class="profile-links">
          <a href={profile.github}>GitHub</a>
          <a href={profile.speakerdeck}>Speaker Deck</a>
          <a href={pagePath(lang, 'engineering')}>{t.aboutSite}</a>
        </div>
        <SourceLinks section="links" />
      </section>
    </header>
    <div class="activity-panel">
      <div class="activity-header">
        <p>{t.activitySummary}</p>
        <LanguageSwitcher lang={lang} page="portfolio" />
      </div>
      <main id="main" tabindex="-1">
        <section class="activity-section" id="projects" aria-labelledby="projects-heading">
          <h2 id="projects-heading">{t.projects}</h2>
          <div class="project-list">
            {content.projects.map(project => <article class="project">
              <h3>{project.name}</h3>
              <p class="project-problem">{project.problem}</p>
              <p>{project.approach}</p>
              <p class="muted project-status">{project.status}</p>
              {project.url && <a class="text-link" href={project.url}>{t.viewGitHub}<span class="sr-only">：{project.name}</span></a>}
            </article>)}
          </div>
          <SourceLinks section="projects" />
        </section>
        <section class="activity-section" id="talks" aria-labelledby="talks-heading">
          <h2 id="talks-heading">{t.talks}</h2>
          <p class="muted">{t.talksDescription}</p>
          <ul class="talk-list">
            {talks.map(talk => <li><a href={talk.url} hreflang="ja">{talk.title[lang]}</a></li>)}
          </ul>
          <a class="text-link" href={profile.speakerdeck}>{t.viewTalks}</a>
          <SourceLinks section="talks" />
        </section>
        <section class="activity-section" id="writing" aria-labelledby="writing-heading">
          <h2 id="writing-heading">{t.writing}</h2>
          <p class="muted">{t.writingEmpty}</p>
          <SourceLinks section="writing" />
        </section>
      </main>
      <Footer lang={lang} />
    </div>
  </div>
</BaseLayout>
