---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { profile } from '../data/portfolio';
import { revision, commitUrl, repositoryUrl, sourceUrl, decisions } from '../lib/site-source';
import { translations } from '../data/translations';
import { pagePath, type Locale } from '../lib/i18n';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = translations[lang];
---
<BaseLayout title={`How this site works — ${profile.name}`} description={t.engineeringDescription} lang={lang} page="engineering">
  <div class="page-shell">
    <header class="site-header">
      <a class="wordmark" href={pagePath(lang, 'portfolio')}>{profile.name}<span aria-hidden="true">.</span></a>
      <div class="header-actions"><nav aria-label={t.pageNavigation}><a href={pagePath(lang, 'portfolio')}>{t.back}</a></nav><LanguageSwitcher lang={lang} page="engineering" /></div>
    </header>
    <main id="main" class="engineering" tabindex="-1">
      <h1>How this site works</h1>
      <p>{t.engineeringIntro}</p>
      <p class="muted">{t.docsLanguage}</p>
      {!revision && <p class="muted">{t.localLinks}</p>}
      <section aria-labelledby="architecture-heading">
        <h2 id="architecture-heading">Architecture</h2>
        <p>{t.architecture}</p>
        {revision ? <p><a href={sourceUrl('docs/architecture.md')!} hreflang="ja">{t.readArchitecture} <span aria-hidden="true">↗</span></a></p> : <p class="muted">{t.localArchitecture}</p>}
      </section>
      <section aria-labelledby="decisions-heading">
        <h2 id="decisions-heading">Design Decisions</h2>
        <p>{t.decisions}</p>
        <ul>{decisions.map(({ title, path }) => <li>{revision ? <a href={sourceUrl(path)!} hreflang="ja">{title[lang]} <span aria-hidden="true">↗</span></a> : <span>{title[lang]}</span>}</li>)}</ul>
      </section>
      <section aria-labelledby="source-heading">
        <h2 id="source-heading">Source Code</h2>
        <p><a href={repositoryUrl}>{t.source} <span aria-hidden="true">↗</span></a></p>
        <p>{t.sourceExplanation}</p>
      </section>
      <section aria-labelledby="audit-heading">
        <h2 id="audit-heading">AI-Ready Audit</h2>
        <p>{t.audit}</p>
        <p>{t.auditLimit}</p>
      </section>
      <section aria-labelledby="build-heading">
        <h2 id="build-heading">Build Information</h2>
        {revision ? <><p>{t.build}</p><p><a class="build-revision" href={commitUrl!}>{revision}</a></p></> : <p>{t.localBuild}</p>}
        <p>{t.buildExplanation}</p>
      </section>
    </main>
    <Footer lang={lang} />
  </div>
</BaseLayout>
