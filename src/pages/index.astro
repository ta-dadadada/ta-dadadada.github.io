---
import Footer from '../components/Footer.astro';
import SourceLinks from '../components/SourceLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, projects } from '../data/portfolio';
const navigation = [
  ['about', 'About'], ['projects', 'Projects'], ['writing', 'Writing'], ['links', 'Links'],
];
---
<BaseLayout title={`${profile.name} — Portfolio`} description="ta-dadadadaの個人開発と技術的な関心をまとめたポートフォリオ。">
  <div class="page-shell">
    <header class="site-header">
      <a class="wordmark" href="#top">{profile.name}<span aria-hidden="true">.</span></a>
      <nav aria-label="ページ内ナビゲーション">
        {navigation.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero" id="top" aria-labelledby="hero-heading">
        <p class="eyebrow">PERSONAL PORTFOLIO <span aria-hidden="true">/</span> ta-dadadada</p>
        <h1 id="hero-heading">ソフトウェアをつくる。<br />その<span class="serif">つくり方</span>を考える。</h1>
        <p class="hero-description">個人開発と、技術的な探究の記録。<br />つくったものと、その背景にある考えを少しずつ。</p>
        <a class="text-link" href="#projects">プロジェクトを見る <span aria-hidden="true">↘</span></a>
        <div class="hero-note"><span class="small-dot" aria-hidden="true"></span>このサイトは準備中です。紹介文は仮の内容です。</div>
        <SourceLinks section="hero" />
        <p class="hero-side" aria-hidden="true">BUILD. REFLECT. REFINE.</p>
      </section>
      <section class="content-section" id="about" aria-labelledby="about-heading">
        <div class="section-label"><span>01 / ABOUT</span><h2 id="about-heading">わたしについて</h2></div>
        <div class="section-body about-body"><p class="lead">{profile.introduction}</p><p>{profile.about}</p><p class="muted">詳しいプロフィールは、これから整えていきます。</p><SourceLinks section="about" /></div>
      </section>
      <section class="content-section" id="projects" aria-labelledby="projects-heading">
        <div class="section-label"><span>02 / PROJECTS</span><h2 id="projects-heading">つくっているもの</h2></div>
        <div class="section-body project-list">
          {projects.map((project, index) => <article class="project">
            <div class="project-meta"><span>{project.category}</span><span>0{index + 1}</span></div>
            <h3>{project.name}</h3><p class="project-problem">{project.problem}</p><p>{project.approach}</p>
            <p class="muted project-status">{project.status}</p>
            {project.url && <a class="text-link" href={project.url}>GitHubで見る <span aria-hidden="true">↗</span><span class="sr-only">：{project.name}</span></a>}
          </article>)}
          <SourceLinks section="projects" />
        </div>
      </section>
      <section class="content-section" id="writing" aria-labelledby="writing-heading">
        <div class="section-label"><span>03 / WRITING</span><h2 id="writing-heading">書いたもの</h2></div>
        <div class="section-body"><p class="lead">考えたことを、言葉に。</p><p>技術記事や外部メディアへのリンクを、ここにまとめていきます。</p><p class="muted">記事はまだ掲載していません。</p><SourceLinks section="writing" /></div>
      </section>
      <section class="content-section" id="links" aria-labelledby="links-heading">
        <div class="section-label"><span>04 / LINKS</span><h2 id="links-heading">ほかの場所で</h2></div>
        <div class="section-body"><a class="profile-link" href={profile.github}><span>GitHub<small>@{profile.name}</small></span><span aria-hidden="true">↗</span></a><SourceLinks section="links" /></div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
