---
import '../styles/global.css';
import { pagePath, type Locale, type Page } from '../lib/i18n';
import { translations } from '../data/translations';
interface Props { title: string; description: string; lang: Locale; page: Page; }
const { title, description, lang, page } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(pagePath(lang, page), Astro.site)} />
    <link rel="alternate" hreflang="ja" href={new URL(pagePath('ja', page), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(pagePath('en', page), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath('ja', page), Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{translations[lang].skip}</a>
    <slot />
  </body>
</html>
